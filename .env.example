# Client — Maps JavaScript only. Restrict this key to HTTP referrers + Maps JS / Places / Routes.
VITE_GOOGLE_MAPS_API_KEY=

# Optional Firebase web config (Auth + Firestore for saved places across devices)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server only — never prefix with VITE_
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=8787
